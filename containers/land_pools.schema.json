{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lci/containers/land_pools.schema.json",
  "title": "land_pools",
  "description": "Located land: feed acres where feed grows, manure acres near the farm; overlap only when declared.",
  "type": "object",
  "required": [
    "land_pool_id",
    "role",
    "region_id",
    "crops"
  ],
  "properties": {
    "land_pool_id": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "feed_production",
        "manure_receiving"
      ]
    },
    "region_id": {
      "type": "string",
      "description": "id in another container"
    },
    "yield": {
      "type": "object",
      "description": "crop yield per area (per crop in crops[] when the rotation has more than one)",
      "required": [
        "value",
        "unit_id",
        "basis",
        "source_id"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "unit_id": {
          "type": "string",
          "description": "id in another container"
        },
        "basis": {
          "type": "string",
          "enum": [
            "as_fed",
            "dry_matter",
            "per_head",
            "per_head_day",
            "per_stage",
            "per_functional_unit",
            "per_area",
            "absolute"
          ]
        },
        "source_id": {
          "type": "string",
          "description": "source id (sources.schema.json)"
        },
        "quality_id": {
          "type": "string",
          "description": "quality record id (quality.schema.json)"
        },
        "note": {
          "type": "string"
        },
        "origin": {
          "type": "string",
          "enum": [
            "entered",
            "derived",
            "overridden"
          ],
          "default": "entered",
          "description": "entered = typed in; derived = computed by the engine each run; overridden = user value replacing a derivable one, kept as is and flagged in results (cite source_id)"
        }
      }
    },
    "n_removal": {
      "type": "object",
      "description": "crop N removal per area (per crop in crops[] when the rotation has more than one)",
      "required": [
        "value",
        "unit_id",
        "basis",
        "source_id"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "unit_id": {
          "type": "string",
          "description": "id in another container"
        },
        "basis": {
          "type": "string",
          "enum": [
            "as_fed",
            "dry_matter",
            "per_head",
            "per_head_day",
            "per_stage",
            "per_functional_unit",
            "per_area",
            "absolute"
          ]
        },
        "source_id": {
          "type": "string",
          "description": "source id (sources.schema.json)"
        },
        "quality_id": {
          "type": "string",
          "description": "quality record id (quality.schema.json)"
        },
        "note": {
          "type": "string"
        },
        "origin": {
          "type": "string",
          "enum": [
            "entered",
            "derived",
            "overridden"
          ],
          "default": "entered",
          "description": "entered = typed in; derived = computed by the engine each run; overridden = user value replacing a derivable one, kept as is and flagged in results (cite source_id)"
        }
      }
    },
    "p_removal": {
      "type": "object",
      "description": "crop P removal per area (per crop in crops[] when the rotation has more than one)",
      "required": [
        "value",
        "unit_id",
        "basis",
        "source_id"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "unit_id": {
          "type": "string",
          "description": "id in another container"
        },
        "basis": {
          "type": "string",
          "enum": [
            "as_fed",
            "dry_matter",
            "per_head",
            "per_head_day",
            "per_stage",
            "per_functional_unit",
            "per_area",
            "absolute"
          ]
        },
        "source_id": {
          "type": "string",
          "description": "source id (sources.schema.json)"
        },
        "quality_id": {
          "type": "string",
          "description": "quality record id (quality.schema.json)"
        },
        "note": {
          "type": "string"
        },
        "origin": {
          "type": "string",
          "enum": [
            "entered",
            "derived",
            "overridden"
          ],
          "default": "entered",
          "description": "entered = typed in; derived = computed by the engine each run; overridden = user value replacing a derivable one, kept as is and flagged in results (cite source_id)"
        }
      }
    },
    "crop_process_id": {
      "type": "string",
      "description": "id in another container"
    },
    "overlaps_with": {
      "type": "string",
      "description": "land_pool_id; set only when a field is declared as both"
    },
    "crops": {
      "type": "array",
      "minItems": 1,
      "description": "Rotation: each crop and its share of years or area; a single crop is one entry with share 1. N and P removal per crop sets the acres manure needs.",
      "items": {
        "type": "object",
        "required": [
          "crop_flow_id",
          "share"
        ],
        "properties": {
          "crop_flow_id": {
            "type": "string",
            "description": "id in flows"
          },
          "share": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "cover_crop": {
      "type": "object",
      "required": [
        "crop_flow_id",
        "fate"
      ],
      "description": "Optional cover crop between cash crops",
      "properties": {
        "crop_flow_id": {
          "type": "string",
          "description": "id in flows"
        },
        "fate": {
          "type": "string",
          "enum": [
            "incorporated",
            "harvested"
          ],
          "description": "incorporated = plowed in (nutrients stay in the field); harvested = removed (adds N and P removal)"
        },
        "crop_process_id": {
          "type": "string",
          "description": "id in unit_processes"
        }
      }
    }
  }
}
