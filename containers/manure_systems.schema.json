{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lci/containers/manure_systems.schema.json",
  "title": "manure_systems",
  "description": "Manure custody chain from the barn floor to land application: in-house collection, then ordered external steps, optionally split by a solid-liquid separator into solid and liquid chains. Starts where excretion ends. Every stream ends in land application (mass balance); the land itself is in land_pools.",
  "type": "object",
  "required": [
    "manure_system_id",
    "in_house"
  ],
  "properties": {
    "manure_system_id": {
      "type": "string"
    },
    "in_house": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "deep_pit",
            "shallow_pit"
          ]
        },
        "process_id": {
          "type": "string",
          "description": "losses and infrastructure of the in-house step (unit_processes)"
        },
        "emptying_per_year": {
          "type": "integer",
          "enum": [
            1,
            2
          ],
          "description": "deep pit only: 1 = emptied in fall after harvest (12-month storage); 2 = fall after harvest and spring before planting (6-month storage). Sets the IPCC storage-period MCF row; timing of application is in production_systems.manure_application"
        }
      }
    },
    "external_steps": {
      "type": "array",
      "description": "in order of flow; a solid_liquid_separator, if present, is the last step and its two fractions carry their own chains to land application",
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "slurry_tank_above_ground",
              "anaerobic_digester",
              "anaerobic_lagoon_single_stage",
              "anaerobic_lagoon_multi_stage",
              "solid_liquid_separator"
            ]
          },
          "process_id": {
            "type": "string",
            "description": "losses, water balance (lagoons) and infrastructure of this step (unit_processes)"
          },
          "partition": {
            "type": "object",
            "description": "share of each constituent sent to the solid fraction (fraction, 0-1); the rest goes to the liquid fraction",
            "required": [
              "mass",
              "total_solids",
              "nitrogen",
              "phosphorus"
            ],
            "properties": {
              "mass": {
                "$ref": "#/$defs/amount"
              },
              "total_solids": {
                "$ref": "#/$defs/amount"
              },
              "volatile_solids": {
                "$ref": "#/$defs/amount"
              },
              "nitrogen": {
                "$ref": "#/$defs/amount"
              },
              "phosphorus": {
                "$ref": "#/$defs/amount"
              },
              "potassium": {
                "$ref": "#/$defs/amount"
              }
            }
          },
          "solid_fraction": {
            "type": "object",
            "required": [
              "routes"
            ],
            "description": "one or more routes with shares summing to 1; every route's residue (stored solids, compost, biochar, ash) ends in land application",
            "properties": {
              "routes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/solid_route"
                }
              }
            }
          },
          "liquid_fraction": {
            "type": "object",
            "description": "liquid chain on the farm; its effluent goes to land application via production_systems.manure_application",
            "properties": {
              "steps": {
                "type": "array",
                "description": "in order of flow; may be empty",
                "items": {
                  "type": "object",
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "slurry_tank_above_ground",
                        "anaerobic_digester",
                        "anaerobic_lagoon_single_stage",
                        "anaerobic_lagoon_multi_stage"
                      ]
                    },
                    "process_id": {
                      "type": "string",
                      "description": "losses, water balance (lagoons) and infrastructure of this step (unit_processes)"
                    },
                    "sludge": {
                      "$ref": "#/$defs/sludge"
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "not": {
                          "properties": {
                            "type": {
                              "enum": [
                                "anaerobic_lagoon_single_stage",
                                "anaerobic_lagoon_multi_stage"
                              ]
                            }
                          }
                        }
                      },
                      "then": {
                        "not": {
                          "required": [
                            "sludge"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "sludge": {
            "$ref": "#/$defs/sludge"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "solid_liquid_separator"
                }
              }
            },
            "then": {
              "required": [
                "partition",
                "solid_fraction",
                "liquid_fraction"
              ]
            },
            "else": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "partition"
                    ]
                  },
                  {
                    "required": [
                      "solid_fraction"
                    ]
                  },
                  {
                    "required": [
                      "liquid_fraction"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "not": {
                "properties": {
                  "type": {
                    "enum": [
                      "anaerobic_lagoon_single_stage",
                      "anaerobic_lagoon_multi_stage"
                    ]
                  }
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "sludge"
                ]
              }
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "in_house": {
            "properties": {
              "type": {
                "const": "deep_pit"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "external_steps": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "in_house": {
            "properties": {
              "type": {
                "const": "shallow_pit"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "external_steps"
        ],
        "properties": {
          "external_steps": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "in_house": {
            "properties": {
              "type": {
                "const": "shallow_pit"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "in_house": {
            "not": {
              "required": [
                "emptying_per_year"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "in_house": {
            "properties": {
              "type": {
                "const": "deep_pit"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "in_house": {
            "required": [
              "emptying_per_year"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "amount": {
      "type": "object",
      "description": "reference quantity",
      "required": [
        "value",
        "unit_id",
        "basis",
        "source_id"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "unit_id": {
          "type": "string",
          "description": "id in another container"
        },
        "basis": {
          "type": "string",
          "enum": [
            "as_fed",
            "dry_matter",
            "per_head",
            "per_head_day",
            "per_stage",
            "per_functional_unit",
            "per_area",
            "absolute"
          ]
        },
        "source_id": {
          "type": "string",
          "description": "source id (sources.schema.json)"
        },
        "quality_id": {
          "type": "string",
          "description": "quality record id (quality.schema.json)"
        },
        "note": {
          "type": "string"
        },
        "origin": {
          "type": "string",
          "enum": [
            "entered",
            "derived",
            "overridden"
          ],
          "default": "entered",
          "description": "entered = typed in; derived = computed by the engine each run; overridden = user value replacing a derivable one, kept as is and flagged in results (cite source_id)"
        }
      }
    },
    "solid_route": {
      "type": "object",
      "required": [
        "share",
        "location",
        "steps"
      ],
      "properties": {
        "share": {
          "$ref": "#/$defs/amount",
          "description": "fraction of the solid fraction taking this route"
        },
        "location": {
          "type": "string",
          "enum": [
            "on_site",
            "off_site"
          ],
          "description": "on_site: processed on the farm, residue land-applied via production_systems.manure_application; off_site: hauled promptly after separation and processed elsewhere"
        },
        "steps": {
          "type": "array",
          "description": "processing in order of flow, on the farm or at the off-site processor; may be empty (e.g. hauled and land-applied directly)",
          "items": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "solid_storage",
                  "drying",
                  "composting",
                  "pyrolysis",
                  "gasification",
                  "other"
                ]
              },
              "process_id": {
                "type": "string",
                "description": "losses, resource use (energy, labor, amendments) and infrastructure of this step (unit_processes)"
              },
              "name": {
                "type": "string",
                "description": "what the step is, required for other (e.g. a novel process)"
              }
            },
            "if": {
              "properties": {
                "type": {
                  "const": "other"
                }
              }
            },
            "then": {
              "required": [
                "name",
                "process_id"
              ]
            }
          }
        },
        "transport_link_id": {
          "type": "string",
          "description": "farm to off-site processor (equipment, labor, energy)"
        },
        "land_pool_id": {
          "type": "string",
          "description": "off-site land receiving the residue"
        }
      },
      "if": {
        "properties": {
          "location": {
            "const": "off_site"
          }
        }
      },
      "then": {
        "required": [
          "transport_link_id",
          "land_pool_id"
        ]
      }
    },
    "sludge": {
      "type": "object",
      "description": "lagoon only: liquid is pumped to land routinely in crop seasons and the lagoon is never emptied; accumulated sludge is removed infrequently by these routes",
      "required": [
        "removal_interval_years",
        "routes"
      ],
      "properties": {
        "removal_interval_years": {
          "type": "number",
          "description": "years between sludge removals"
        },
        "routes": {
          "type": "array",
          "minItems": 1,
          "description": "shares summing to 1: agitated and land-applied as slurry on the farm (on_site, no steps), or excavated and hauled off-site for drying, composting or other processing",
          "items": {
            "$ref": "#/$defs/solid_route"
          }
        }
      }
    }
  }
}
