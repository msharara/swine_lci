{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lci/containers/herd_systems.schema.json",
  "title": "herd_systems",
  "description": "The animals only: a group of animals fed and maintained. Converts one functional unit (one shipped market pig with its share of sows, boars and replacement gilts) into animal-days, intake, nutrient requirements and excretion per stage. No sites, housing, manure handling or diet recipes (see feeding_programs).",
  "type": "object",
  "required": [
    "herd_id",
    "species",
    "functional_unit",
    "reference_year",
    "stages"
  ],
  "properties": {
    "herd_id": {
      "type": "string"
    },
    "species": {
      "type": "string",
      "enum": [
        "swine",
        "broiler",
        "layer",
        "dairy",
        "beef"
      ]
    },
    "functional_unit": {
      "type": "string",
      "description": "e.g. 1 shipped market pig at 2022-typical slaughter weight"
    },
    "reference_year": {
      "type": "integer"
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stage",
          "animal_days_per_unit"
        ],
        "properties": {
          "stage": {
            "type": "string",
            "enum": [
              "gestation",
              "farrowing_lactation",
              "gilt_development",
              "boar",
              "nursery",
              "finishing"
            ]
          },
          "animal_days_per_unit": {
            "type": "object",
            "description": "animal-days of this stage needed per functional unit",
            "required": [
              "value",
              "unit_id",
              "basis",
              "source_id"
            ],
            "properties": {
              "value": {
                "type": "number"
              },
              "unit_id": {
                "type": "string",
                "description": "id in units"
              },
              "basis": {
                "type": "string",
                "enum": [
                  "as_fed",
                  "dry_matter",
                  "per_head",
                  "per_head_day",
                  "per_stage",
                  "per_functional_unit",
                  "per_area",
                  "absolute"
                ]
              },
              "source_id": {
                "type": "string",
                "description": "id in sources"
              },
              "quality_id": {
                "type": "string",
                "description": "id in quality"
              },
              "note": {
                "type": "string"
              },
              "origin": {
                "type": "string",
                "enum": [
                  "entered",
                  "derived",
                  "overridden"
                ],
                "default": "entered",
                "description": "entered = typed in; derived = computed by the engine each run; overridden = user value replacing a derivable one, kept as is and flagged in results (cite source_id)"
              }
