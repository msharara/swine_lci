          "mortality_timing": {
            "type": "object",
            "description": "when in the stage deaths occur, as a distribution over stage progress (0 = stage start, 1 = stage end). Feed and manure of dead pigs are integrated over this distribution and the stage's intake curve. Beta skews deaths toward the start (alpha<beta) or end (alpha>beta) of the stage.",
            "required": [
              "distribution"
            ],
            "properties": {
              "distribution": {
                "type": "string",
                "enum": [
                  "uniform",
                  "beta"
                ],
                "default": "uniform"
              },
              "beta_alpha": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "beta_beta": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "source_id": {
                "type": "string",
                "description": "id in sources, when skewed from uniform"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "distribution": {
                      "const": "beta"
                    }
                  }
                },
                "then": {
                  "required": [
                    "beta_alpha",
                    "beta_beta"
                  ]
                }
              }
            ]
          },
          "cumulative_intake_curve": {
            "type": "object",
            "description": "published feed budget for the stage: cumulative share of stage feed eaten vs stage progress. Used first for dead-pig feed; if absent, the engine falls back to phase steps from the feeding program.",
            "required": [
              "points",
              "source_id"
            ],
            "properties": {
              "progress_basis": {
                "type": "string",
                "enum": [
                  "days",
                  "body_weight"
                ],
                "default": "days"
              },
              "points": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "required": [
                    "progress",
                    "cumulative_share"
                  ],
                  "properties": {
                    "progress": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "cumulative_share": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                }
              },
              "source_id": {
                "type": "string",
                "description": "id in sources"
              }
            }
          },
          "dead_pig_intake_method": {
            "type": "string",
            "enum": [
              "feed_budget_curve",
              "phase_steps",
              "proportional_days"
            ],
            "description": "set by the engine, not entered: feed_budget_curve when a curve exists, else phase_steps; proportional_days only as a labeled last resort"
          }
        }
